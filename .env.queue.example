# ============================================================
# n8n on GCP Cloud Run — Queue Mode Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.queue.example .env
#
# Queue mode separates n8n into a Main process (UI + webhooks)
# and Worker processes (workflow execution) connected via Redis.
# ============================================================

# --- GCP Project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west4

# --- Cloud SQL (Postgres) ---
DB_INSTANCE_NAME=n8n-db-instance
DB_VERSION=POSTGRES_14
DB_TIER=db-custom-1-3840
DB_NAME=n8n_database
DB_USER=n8nuser
DB_PASSWORD=CHANGE_ME_BEFORE_RUNNING
DB_ENABLE_BACKUPS=true

# --- Secret Manager secret names ---
SECRET_DB_PASSWORD=n8n-db-pwd
SECRET_ENCRYPTION_KEY=n8n-encryption-key

# --- Cloud Run: Main (UI + webhooks) ---
CLOUD_RUN_SERVICE=n8n-main
CLOUD_RUN_MEMORY=2Gi
CLOUD_RUN_PORT=5678
CLOUD_RUN_MIN_INSTANCES=1
CLOUD_RUN_MAX_INSTANCES=2

# --- Cloud Run: Workers (workflow execution) ---
WORKER_SERVICE=n8n-worker
WORKER_MEMORY=2Gi
WORKER_MIN_INSTANCES=1
WORKER_MAX_INSTANCES=5
WORKER_CONCURRENCY=10

# --- n8n Docker image ---
N8N_VERSION=latest

# --- Redis (Cloud Memorystore) ---
REDIS_INSTANCE_NAME=n8n-queue
REDIS_TIER=BASIC
REDIS_SIZE_GB=1
REDIS_VERSION=REDIS_7_0

# --- VPC Connector (required for Cloud Run → Memorystore) ---
VPC_CONNECTOR_NAME=n8n-vpc-connector
VPC_CONNECTOR_RANGE=10.8.0.0/28

# --- n8n Settings ---
N8N_PAYLOAD_SIZE_MAX=256
N8N_PROCESS_TIMEOUT=7200000
N8N_LOG_LEVEL=info
GENERIC_TIMEZONE=Europe/Amsterdam
N8N_PROXY_HOPS=1

# --- Service Account ---
SERVICE_ACCOUNT_NAME=n8n-cloudrun-sa
