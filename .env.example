# ============================================================
# n8n on GCP Cloud Run — Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Passwords are only used once to seed Secret Manager —
# they are never baked into the container image.
# ============================================================

# --- GCP Project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1 

# --- Cloud SQL (Postgres) ---
DB_INSTANCE_NAME=n8n-db-instance
DB_VERSION=POSTGRES_14
DB_TIER=db-custom-1-3840
DB_NAME=n8n_database
DB_USER=n8nuser
DB_PASSWORD=CHANGE_ME_BEFORE_RUNNING
# Enable automated daily backups (recommended, ~$2-5/month)
DB_ENABLE_BACKUPS=true

# --- Secret Manager secret names ---
SECRET_DB_PASSWORD=n8n-db-pwd
SECRET_ENCRYPTION_KEY=n8n-encryption-key

# --- Cloud Run ---
CLOUD_RUN_SERVICE=n8n
CLOUD_RUN_MEMORY=2Gi
CLOUD_RUN_PORT=5678
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=3
# Pin the n8n Docker image version (check https://hub.docker.com/r/n8nio/n8n/tags)
N8N_VERSION=latest

# --- n8n Settings ---
N8N_PAYLOAD_SIZE_MAX=256
N8N_CONCURRENCY_PRODUCTION_LIMIT=20
N8N_PROCESS_TIMEOUT=7200000
N8N_LOG_LEVEL=info
GENERIC_TIMEZONE=Europe/Amsterdam
# Number of reverse proxies in front of n8n (Cloud Run = 1)
N8N_PROXY_HOPS=1

# --- Service Account ---
SERVICE_ACCOUNT_NAME=n8n-cloudrun-sa
